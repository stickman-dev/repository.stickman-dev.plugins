<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.stickman-dev.plugins" name="stickman-dev Add-on Repository" version="1.0.0" provider-name="stickman-dev">
	<requires>
		<import addon="xbmc.addon" version="12.0.0"/>
	</requires>
	<extension point="xbmc.addon.repository" name="stickman-dev Add-on Repository">
		<dir>
			<info compressed="false">https://raw.githubusercontent.com/stickman-dev/repository.stickman-dev.plugins/main/zips/addons.xml</info>
			<checksum>https://raw.githubusercontent.com/stickman-dev/repository.stickman-dev.plugins/main/zips/addons.xml.md5</checksum>
			<datadir zip="true">https://raw.githubusercontent.com/stickman-dev/repository.stickman-dev.plugins/main/zips/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary>stickman-dev Add-on Repository</summary>
		<description>Add-ons maintained by stickman-dev, currently just VPN Manager for OpenVPN.</description>
		<platform>all</platform>
		<assets>
			<icon>resources/icon.png</icon>
		</assets>
	</extension>
</addon>
